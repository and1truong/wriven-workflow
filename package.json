{
  "name": "wriven-workflow",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "module": "src/main.ts",
  "scripts": {
    "build": "bun build --compile --minify --sourcemap=none src/main.ts --outfile dist/wriven-workflow",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "release": "bun run scripts/release.ts",
    "test:example": "cd examples/host && bun install --frozen-lockfile && bun test",
    "typecheck:example": "tsc --noEmit -p examples/host"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
