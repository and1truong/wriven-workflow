{
  "format": "wriven-workflow/pipeline@1",
  "name": "Feed digest about one topic",
  "description": "Summarize new posts whose title mentions alpha.",
  "input": {
    "type": "host_trigger"
  },
  "processors": [
    {
      "id": "fetch",
      "type": "http_fetch",
      "urls": [
        "https://example.com/feed.xml",
        "https://blog.example.org/rss",
        "https://news.example.net/atom.xml"
      ],
      "on_error": "skip"
    },
    {
      "id": "parse",
      "type": "parse_feed",
      "on_error": "skip"
    },
    {
      "id": "new_only",
      "type": "dedupe",
      "key": "/id",
      "remember": "90d"
    },
    {
      "id": "topic",
      "type": "filter",
      "keep_if": {
        "field": "/title",
        "contains_any": [
          "alpha"
        ],
        "case": "insensitive"
      }
    },
    {
      "id": "gather",
      "type": "collect",
      "min_items": 1,
      "max_items": 50
    },
    {
      "id": "prompt",
      "type": "template",
      "target": "/prompt",
      "text": "Summarize these posts for a busy reader. Group by theme, keep links.\n\n{{/items}}"
    },
    {
      "id": "summarize",
      "type": "host_llm",
      "prompt": "/prompt",
      "target": "/summary"
    }
  ],
  "output": {
    "type": "host_result",
    "title": "Morning digest",
    "body": "/summary",
    "format": "markdown"
  },
  "limits": {
    "llm_calls_per_run": 1,
    "runs_per_day": 2,
    "run_timeout": "5m"
  },
  "tests": [
    {
      "name": "matching posts make one digest",
      "fixtures": {
        "https://example.com/feed.xml": {
          "status": 200,
          "content_type": "application/rss+xml",
          "body": "<?xml version=\"1.0\"?><rss version=\"2.0\"><channel><title>Alpha</title><item><title>Alpha a1</title><guid>a1</guid></item><item><title>Alpha a2</title><guid>a2</guid></item></channel></rss>"
        },
        "https://blog.example.org/rss": {
          "status": 200,
          "content_type": "application/rss+xml",
          "body": "<?xml version=\"1.0\"?><rss version=\"2.0\"><channel><title>Beta</title><item><title>Beta b1</title><guid>b1</guid></item></channel></rss>"
        },
        "https://news.example.net/atom.xml": {
          "status": 200,
          "content_type": "application/rss+xml",
          "body": "<?xml version=\"1.0\"?><rss version=\"2.0\"><channel><title>Gamma</title><item><title>Gamma g1</title><guid>g1</guid></item></channel></rss>"
        }
      },
      "llm": {
        "mode": "mock",
        "responses": [
          "The digest."
        ]
      },
      "expect": {
        "status": "succeeded",
        "results_count": 1,
        "result_body_contains": [
          "The digest."
        ],
        "warnings_count": 0
      }
    }
  ]
}
