{
  "name": "Two concurrent host.llm calls",
  "description": "A host that declares llm_concurrency 2 sees two host.llm requests from two workflow branches before it answers either. Cancelling the run sends $/cancel for both.",
  "fake_host": {
    "llm": {
      "mode": "hold"
    }
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": "h-1",
        "method": "initialize",
        "params": {
          "protocol_version": 1,
          "host": {
            "name": "conformance",
            "version": "0",
            "display_name": "Wriven"
          },
          "clock": "host",
          "state_dir": "$state_dir",
          "sandbox": "optional",
          "capabilities": {
            "llm": true,
            "llm_reports_cost": false,
            "results": true,
            "live_network_in_tests": false,
            "llm_concurrency": 2
          }
        }
      }
    },
    {
      "expect": {
        "id": "h-1",
        "result": {
          "protocol_version": 1
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": "h-2",
        "method": "stream.create",
        "params": {
          "pipeline": {
            "format": "wriven-workflow/pipeline@1",
            "name": "Two branches",
            "input": {
              "type": "host_trigger"
            },
            "processors": [
              {
                "id": "prompt",
                "type": "template",
                "target": "/prompt",
                "text": "Say hello to {{/trigger}}"
              },
              {
                "id": "both",
                "type": "workflow",
                "branches": [
                  {
                    "id": "left",
                    "steps": [
                      {
                        "id": "ask_left",
                        "type": "host_llm",
                        "prompt": "/prompt",
                        "target": "/reply"
                      }
                    ],
                    "result": "/reply",
                    "target": "/left"
                  },
                  {
                    "id": "right",
                    "steps": [
                      {
                        "id": "ask_right",
                        "type": "host_llm",
                        "prompt": "/prompt",
                        "target": "/reply"
                      }
                    ],
                    "result": "/reply",
                    "target": "/right"
                  }
                ]
              }
            ],
            "output": {
              "type": "host_result",
              "title": "Both",
              "body": "/left"
            },
            "limits": {
              "llm_calls_per_run": 2,
              "runs_per_day": 48,
              "run_timeout": "5m"
            }
          }
        }
      }
    },
    {
      "expect": {
        "id": "h-2",
        "result": {
          "status": "pending_approval"
        }
      },
      "capture": {
        "stream": "/result/stream_id",
        "hash": "/result/permissions_hash"
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": "h-3",
        "method": "stream.approve",
        "params": {
          "stream_id": "$stream",
          "permissions_hash": "$hash"
        }
      }
    },
    {
      "expect": {
        "id": "h-3",
        "result": {
          "stream_id": "$stream",
          "status": "active"
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": "h-4",
        "method": "run.trigger",
        "params": {
          "stream_id": "$stream"
        }
      }
    },
    {
      "expect": {
        "id": "h-4",
        "result": {
          "run_id": "<string>",
          "status": "queued"
        }
      },
      "capture": {
        "run": "/result/run_id"
      }
    },
    {
      "expect": {
        "method": "host.llm",
        "id": "<string>",
        "params": {
          "run_id": "$run",
          "step_id": "ask_left",
          "message_id": "m1",
          "idempotency_key": "$run/ask_left/m1"
        }
      },
      "capture": {
        "left": "/id"
      }
    },
    {
      "expect": {
        "method": "host.llm",
        "id": "<string>",
        "params": {
          "run_id": "$run",
          "step_id": "ask_right",
          "message_id": "m1",
          "idempotency_key": "$run/ask_right/m1"
        }
      },
      "capture": {
        "right": "/id"
      }
    },
    {
      "assert_fake_host": {
        "provider_calls": 2
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": "h-5",
        "method": "run.cancel",
        "params": {
          "run_id": "$run"
        }
      }
    },
    {
      "expect": {
        "id": "h-5",
        "result": {
          "run_id": "$run"
        }
      }
    },
    {
      "expect": {
        "method": "$/cancel",
        "params": {
          "id": "$left"
        }
      }
    },
    {
      "expect": {
        "method": "$/cancel",
        "params": {
          "id": "$right"
        }
      }
    },
    {
      "expect": {
        "method": "run.finished",
        "params": {
          "report": {
            "run_id": "$run",
            "status": "cancelled",
            "results": []
          }
        }
      },
      "within_ms": 7000
    },
    {
      "close_stdin": true
    },
    {
      "expect_exit": 0,
      "within_ms": 11000
    }
  ]
}
